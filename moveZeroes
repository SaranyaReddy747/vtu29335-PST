class Solution {
    public void moveZeroes(int[] nums) {
        int insertPos = 0;
        
        // Phase 1: Shift all non-zero elements forward
        for (int num : nums) {
            if (num != 0) {
                nums[insertPos++] = num;
            }
        }
        
        // Phase 2: Fill the remaining positions with zeroes
        while (insertPos < nums.length) {
            nums[insertPos++] = 0;
        }
    }
}
